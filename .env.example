# Redis connection
REDIS_URL=redis://redis:6379

# Server config
HOST=0.0.0.0
PORT=3000

# Default clip expiry in seconds (default: 4 hours = 14400)
COPPY_DEFAULT_TTL=14400

# Max TTL in seconds (default: 1 week = 604800)
COPPY_MAX_TTL=604800

# API token for write operations (leave empty for open-access dev mode)
# Generate one: openssl rand -hex 24
COPPY_API_TOKEN=
